<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg"
	android:orientation="vertical"
	android:paddingTop="24dp">

	<TextView
		android:id="@+id/title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingHorizontal="20dp"
		android:paddingBottom="12dp"
		android:text="Settings"
		android:textColor="@color/accent_green"
		android:textSize="20sp"
		android:textStyle="bold" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="20dp"
			android:paddingBottom="24dp">

			<TextView
				android:id="@+id/label_fps"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:letterSpacing="0.08"
				android:text="FPS Limit"
				android:textColor="@color/text_dim"
				android:textSize="14sp"
				android:textStyle="bold" />

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				app:cardBackgroundColor="@color/card"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeColor="@color/border"
				app:strokeWidth="1dp">

				<LinearLayout
					android:id="@+id/fps_group"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:padding="8dp">

					<Button
						android:id="@+id/fps_30"
						android:layout_width="0dp"
						android:layout_height="40dp"
						android:layout_weight="1"
						android:backgroundTint="@color/card"
						android:gravity="center"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minWidth="0dp"
						android:padding="0dp"
						android:text="30"
						android:textColor="@color/text_main"
						android:textSize="13sp"
						android:textStyle="bold" />

					<Button
						android:id="@+id/fps_60"
						android:layout_width="0dp"
						android:layout_height="40dp"
						android:layout_weight="1"
						android:backgroundTint="@color/card"
						android:gravity="center"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minWidth="0dp"
						android:padding="0dp"
						android:text="60"
						android:textColor="@color/text_main"
						android:textSize="13sp"
						android:textStyle="bold" />

					<Button
						android:id="@+id/fps_90"
						android:layout_width="0dp"
						android:layout_height="40dp"
						android:layout_weight="1"
						android:backgroundTint="@color/card"
						android:gravity="center"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minWidth="0dp"
						android:padding="0dp"
						android:text="90"
						android:textColor="@color/text_main"
						android:textSize="13sp"
						android:textStyle="bold" />

					<Button
						android:id="@+id/fps_120"
						android:layout_width="0dp"
						android:layout_height="40dp"
						android:layout_weight="1"
						android:backgroundTint="@color/card"
						android:gravity="center"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minWidth="0dp"
						android:padding="0dp"
						android:text="120"
						android:textColor="@color/text_main"
						android:textSize="13sp"
						android:textStyle="bold" />

					<Button
						android:id="@+id/fps_180"
						android:layout_width="0dp"
						android:layout_height="40dp"
						android:layout_weight="1"
						android:backgroundTint="@color/card"
						android:gravity="center"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:minWidth="0dp"
						android:padding="0dp"
						android:text="180"
						android:textColor="@color/text_main"
						android:textSize="13sp"
						android:textStyle="bold" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<TextView
				android:id="@+id/fps_hint"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="8dp"
				android:text="Above 60 may be unstable on some devices"
				android:textColor="@color/text_dim"
				android:textSize="12sp" />

		</LinearLayout>
	</ScrollView>

	<TextView
		android:id="@+id/ga_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:letterSpacing="0.08"
		android:text="Global Assets"
		android:gravity="center"
		android:textColor="@color/accent_blue"
		android:textSize="20sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/ga_desc"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:letterSpacing="0.08"
		android:gravity="center"
		android:text="Assets that override mod and vanilla assets. Experimental."
		android:textColor="@color/text_dim"
		android:textSize="12sp"
		android:textStyle="bold" />

	<com.google.android.material.card.MaterialCardView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:layout_marginTop="4dp"
		android:layout_marginBottom="20sp"
		app:cardBackgroundColor="@color/card"
		app:cardCornerRadius="8dp"
		app:cardElevation="8dp"
		app:strokeColor="@color/border"
		app:strokeWidth="1dp">

		<LinearLayout
			android:id="@+id/global_assets"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingHorizontal="120sp"
			android:padding="0dp">

			<Button
				android:id="@+id/ga_clear"
				android:layout_width="0dp"
				android:layout_height="60sp"
				android:layout_marginTop="0sp"
				android:layout_weight="1"
				android:backgroundTint="@color/card"
				android:gravity="center"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:padding="0dp"
				android:text="Clear Assets"
				android:textAllCaps="false"
				android:textColor="@color/text_main"
				android:textSize="14sp"
				android:textStyle="bold" />

			<Button
				android:id="@+id/ga_import"
				android:layout_width="0dp"
				android:layout_height="60sp"
				android:layout_weight="1"
				android:height="50sp"
				android:backgroundTint="@color/card"
				android:gravity="center"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:padding="0dp"
				android:text="Import Assets"
				android:textAllCaps="false"
				android:textColor="@color/text_main"
				android:textSize="14sp"
				android:textStyle="bold" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>


	<com.google.android.material.card.MaterialCardView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="20dp"
		android:layout_marginBottom="20dp"
		app:cardBackgroundColor="#5865F2"
		app:cardCornerRadius="14dp"
		app:cardElevation="0dp">

		<Button
			android:id="@+id/discordbtn"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@android:color/transparent"
			android:text="Discord Server"
			android:textAllCaps="false"
			android:textColor="#FFFFFF"
			android:textSize="16sp"
			android:textStyle="bold" />
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
